<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

  <changeSet id="2025-04-15-23-42" author="mikhail-karpov" context="prod">
    <createTable tableName="message">
      <column name="id" type="UUID">
        <constraints nullable="false" primaryKey="true" primaryKeyName="message_pk"/>
      </column>
      <column name="user_id" type="VARCHAR">
        <constraints nullable="false" references="users(id)" foreignKeyName="users_fk"/>
      </column>
      <column name="text" type="VARCHAR(128)">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="TIMESTAMPTZ">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
</databaseChangeLog>
